{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AustineLomocso/reprise/schemas/site-index.schema.json",
  "title": "Reprise site index (data/index.json, generated by build-site)",
  "description": "docs/kit/02-specs/data-contracts.md, 'Site index', with data_source (ADR-13).",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "repo", "provider", "data_source", "totals", "issues"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "provider": { "description": "Provider of the most recently updated record; null when there are no records.", "enum": ["claude", "bob", null] },
    "data_source": { "enum": ["sample", "live"] },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues", "by_state", "median_time_to_verdict_ms", "median_bobcoins_per_triage",
        "median_tokens_per_triage", "fixes_verified", "regressions_caught"
      ],
      "properties": {
        "issues": { "type": "integer", "minimum": 0 },
        "by_state": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "NEW", "TRIAGING", "CONFIRMED", "FLAKY", "DUPLICATE", "NEEDS_INFO", "BLOCKED_ENV", "ERROR",
              "FIXING", "FIX_ABANDONED", "VERIFYING", "FIX_VERIFIED", "FIX_INCOMPLETE", "REGRESSION_DETECTED", "RESOLVED"
            ]
          },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "median_time_to_verdict_ms": { "type": ["number", "null"], "minimum": 0 },
        "median_bobcoins_per_triage": { "type": ["number", "null"], "minimum": 0 },
        "median_tokens_per_triage": { "type": ["number", "null"], "minimum": 0 },
        "fixes_verified": { "type": "integer", "minimum": 0 },
        "regressions_caught": { "type": "integer", "minimum": 0 }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "title", "state", "verdict", "rate", "sequence", "updated_at", "bobcoins_total", "tokens_total", "pr"],
        "properties": {
          "issue": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "state": {
            "enum": [
              "NEW", "TRIAGING", "CONFIRMED", "FLAKY", "DUPLICATE", "NEEDS_INFO", "BLOCKED_ENV", "ERROR",
              "FIXING", "FIX_ABANDONED", "VERIFYING", "FIX_VERIFIED", "FIX_INCOMPLETE", "REGRESSION_DETECTED", "RESOLVED"
            ]
          },
          "verdict": { "enum": ["CONFIRMED", "FLAKY", "DUPLICATE", "NEEDS_INFO", "BLOCKED_ENV", null] },
          "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "sequence": { "type": ["string", "null"], "pattern": "^[PFX]*$" },
          "updated_at": { "type": "string", "format": "date-time" },
          "bobcoins_total": { "type": "number", "minimum": 0 },
          "tokens_total": { "type": "integer", "minimum": 0 },
          "pr": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    }
  }
}
