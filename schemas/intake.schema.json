{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AustineLomocso/reprise/schemas/intake.schema.json",
  "title": "Intake stage output",
  "description": "docs/kit/02-specs/triage-pipeline.md section 2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fingerprint", "attempt_possible", "missing", "question"],
  "properties": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "functions", "symptom", "trigger", "expected", "actual", "error_signature"],
      "properties": {
        "component": { "type": "string" },
        "functions": { "type": "array", "items": { "type": "string" } },
        "symptom": { "type": "string" },
        "trigger": { "type": "string" },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "error_signature": { "type": "string" }
      }
    },
    "attempt_possible": { "type": "boolean" },
    "missing": { "type": "array", "items": { "type": "string" } },
    "question": { "type": "string" }
  }
}
